    I -->|"LED OFF"| K["Xil_Out32(BASE + 0x00, 0U)"]
    I -->|"STATUS"| L["레지스터 쓰기 없음"]
    I -->|"그 외"| M["ERROR: use LED ON / LED OFF / STATUS"]
    J --> N["report_status()<br/>Xil_In32()로 REG0 읽기"]
